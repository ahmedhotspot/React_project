+    maxDeltaY = MAX_VALUE_IGNORE
+    maxDistSq = MAX_VALUE_IGNORE
+    maxDurationMs = DEFAULT_MAX_DURATION_MS
+    maxDelayMs = DEFAULT_MAX_DELAY_MS
