+        -1 // only A is active
+      } else if (b.isActive) {
+        1 // only B is active
+      } else if (a.isAwaiting) {
+        -1 // only A is awaiting, B is inactive
+      } else if (b.isAwaiting) {
+        1 // only B is awaiting, A is inactive
+      } else {
+        0 // both A and B are inactive, stable order matters
