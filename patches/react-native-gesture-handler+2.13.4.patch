+      registerHandler(jsGestureHandler)
+      attachHandlerToView(jsGestureHandler.tag, wrappedViewTag, GestureHandler.ACTION_TYPE_JS_FUNCTION_OLD_API)
+    }
+    module.registerRootHelper(this)
+  }
